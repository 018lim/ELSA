# ELSA 설정값 예시
# 이 파일을 같은 폴더에 secrets.toml로 복사한 뒤 값을 채우세요.
# secrets.toml은 .gitignore에 등록되어 있어 커밋되지 않습니다.

EXTRACTOR = "gemini"                 # "gemini" 또는 "claude"
EXTRACTOR_MODEL = "gemini-flash-lite-latest"   # 사용할 모델 이름 (권장값)
GEMINI_API_KEY = ""                  # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY = ""               # EXTRACTOR="claude"일 때만 필요
ECOS_API_KEY = ""                    # 한국은행 ECOS 인증키 (국고채 3년 금리 불러오기, 비우면 네이버 금융 값 사용)
ACCESS_CODE = ""                     # 비우면 접근 코드 없음
MAX_EXTRACTIONS_PER_SESSION = 5
